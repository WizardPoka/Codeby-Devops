# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Общий образ для обеих машин
  config.vm.box = "bento/ubuntu-22.04"
  config.vm.box_check_update = false

  # ========== SERVER ==========
  config.vm.define "server" do |server|
    server.vm.hostname = "server"
    server.vm.network "private_network", ip: "192.168.56.10"
    
    server.vm.provider "virtualbox" do |vb|
      vb.name = "vagrant_server"
      vb.memory = "1024"
      vb.cpus = 1
    end

    # Провижининг для server: создаём пользователя и настраиваем SSH
    server.vm.provision "shell", path: "scripts/server.sh"
  end

  # ========== CLIENT ==========
  config.vm.define "client" do |client|
    client.vm.hostname = "client"
    client.vm.network "private_network", ip: "192.168.56.11"
    
    client.vm.provider "virtualbox" do |vb|
      vb.name = "vagrant_client"
      vb.memory = "1024"
      vb.cpus = 1
    end

    # Провижининг для client: копируем ключ и настраиваем SSH config
    client.vm.provision "shell", path: "scripts/client.sh"
  end
end