# -*- mode: ruby -*-
# vi: set ft=ruby :

# Урок 11 (ветка lesson12): два окружения Ansible — dev и prod.
# Обе ВМ используют стандартный Vagrant insecure key, чтобы не хранить
# приватный ключ в публичном репозитории.

# Публичный box по умолчанию. Локально можно переопределить:
#   VAGRANT_BOX=codeby/noble64 vagrant up
VAGRANT_BOX = ENV.fetch("VAGRANT_BOX", "bento/ubuntu-24.04")
PRIVATE_NETWORK_PREFIX = "192.168.56"

Vagrant.configure("2") do |config|
  config.vm.box = VAGRANT_BOX
  config.vm.boot_timeout = 600

  # Ansible подключается по SSH-ключу. Insecure key — стандартный
  # публичный ключ Vagrant, он есть в любой установке Vagrant.
  config.ssh.insert_key = false

  # Общая папка не нужна и требует совпадающих Guest Additions.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  {
    "dev"  => { ip: "#{PRIVATE_NETWORK_PREFIX}.10", memory: 1024, cpus: 1 },
    "prod" => { ip: "#{PRIVATE_NETWORK_PREFIX}.11", memory: 1024, cpus: 1 }
  }.each do |name, opts|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: opts[:ip]

      node.vm.provider "virtualbox" do |vb|
        vb.name = "codeby-lesson12-#{name}"
        vb.memory = opts[:memory]
        vb.cpus = opts[:cpus]
      end

      # Ставим только python3 — он нужен Ansible. Пакеты задания
      # (wget, htop, nginx) устанавливает уже сам playbook.
      node.vm.provision "shell", path: "scripts/bootstrap.sh"
    end
  end
end
